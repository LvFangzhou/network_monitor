# 网络运营平台环境变量配置

# 应用配置
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production
ENABLE_API_DOCS=false
ENABLE_AUTH_INIT=false
AUTH_INIT_TOKEN=
INTERNAL_API_TOKEN=generate-a-random-internal-token
BACKEND_CORS_ORIGINS=http://172.18.17.250:8080

# 持久化数据目录。生产环境建议放在项目目录外，避免代码同步误删数据。
DATA_ROOT=/opt/network_monitor_data
INFLUXDB_DATA_ROOT=/opt/network_monitor_data/influxdb
BACKUP_ROOT=/opt/network_monitor_backups

# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=network_monitor
POSTGRES_PASSWORD=network_monitor
POSTGRES_DB=network_monitor

# InfluxDB2 配置
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=network-monitor-token
INFLUXDB_ORG=network-monitor
INFLUXDB_BUCKET=network_metrics
INFLUXDB_DATA_PATH=/host-data/influxdb
GRAFANA_DATA_ROOT=./data/grafana
GRAFANA_ROOT_URL=http://localhost:10086/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
GRAFANA_POSTGRES_PASSWORD=replace-with-a-strong-readonly-password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ 配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# SNMP 配置
SNMP_DEFAULT_TIMEOUT=5
SNMP_DEFAULT_RETRIES=3

# gNMI 配置
GNMI_DEFAULT_PORT=57400
GNMI_BATCH_SIZE=1000
GNMI_BATCH_TIMEOUT=1.0

# 告警配置
ALERT_CHECK_INTERVAL=30
ALERT_RESOLVE_INTERVAL=60

# 企业微信配置
WECHAT_WEBHOOK_URL=

# 钉钉配置
DINGTALK_WEBHOOK_URL=

# 系统自检告警机器人，可填企业微信/飞书/钉钉 webhook；为空时复用上面的告警机器人
SYSTEM_ALERT_WEBHOOK_URL=

# SMTP 邮件配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
